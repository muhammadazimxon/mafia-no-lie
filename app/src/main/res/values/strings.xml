    <string name="mimicAbility_">Mimicking / dual voting</string>
    <string name="mafiaAbility_">Night elimination</string>
    <string name="barmanAbility_">Player control (speech disruption)</string>
    <string name="informatorAbility_">Role reveal (mafia-facing)</string>
    <string name="bomberAbility_">Activation sequence</string>
    <string name="donAbility_">Leadership + informator ability</string>
    <string name="barmanException_">Cannot vote at night while any other mafia are still active. Gains night-vote ability only after all other mafia are eliminated.</string>
    <string name="informatorException_">Cannot vote at night while any other mafia are still active. Gains night-vote ability only after all other mafia are eliminated.</string>
    <string name="bomberException_">Cannot vote at night while any other mafia are still active. Gains night-vote ability only after all other mafia are eliminated.</string>
